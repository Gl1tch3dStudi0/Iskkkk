-- SHIFT LOCK
local shiftConn=nil
local function enableShift()
    local h=getHum()
    if not h then return end
    UIS.MouseBehavior=Enum.MouseBehavior.LockCenter
    h.AutoRotate=false
    if shiftConn then shiftConn:Disconnect() end
    shiftConn=RS.RenderStepped:Connect(function()
        if not S.shiftlock then return end
        local hh,hrp=getHum(),getHRP()
        if not hh or not hrp or hh.Health<=0 then return end
        if hh:GetState()==Enum.HumanoidStateType.Dead then return end
        hh.CameraOffset=Vector3.new(1.75,0.5,0)
        if hh.MoveDirection.Magnitude>0.01 then
            local cl=Cam.CFrame.LookVector
            local fl=Vector3.new(cl.X,0,cl.Z)
            if fl.Magnitude>0.01 then
                hrp.CFrame=CFrame.new(hrp.Position,hrp.Position+fl.Unit)
            end
        end
    end)
end
local function disableShift()
    UIS.MouseBehavior=Enum.MouseBehavior.Default
    local h=getHum()
    if h then
        h.CameraOffset=Vector3.zero
        h.AutoRotate=true
    end
    if shiftConn then shiftConn:Disconnect() shiftConn=nil end
end
LP.CharacterAdded:Connect(function()
