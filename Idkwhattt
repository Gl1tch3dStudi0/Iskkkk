-- AIMBOT
local AIM_PARTS={"Head","HumanoidRootPart","UpperTorso","LowerTorso","LeftLeg","RightLeg","LeftArm","RightArm"}
local function getAimTarget()
    local best,bs=nil,math.huge
    local myPos=Cam.CFrame.Position
    local sc=Cam.ViewportSize/2
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and plr.Character then
            local pt=plr.Character:FindFirstChild(S.aimPart)
            if not pt then pt=plr.Character:FindFirstChild("HumanoidRootPart") end
            if pt then
                local sp,on=Cam:WorldToViewportPoint(pt.Position)
                if on then
                    local d2=(Vector2.new(sp.X,sp.Y)-sc).Magnitude
                    if d2<=S.aimFov then
                        local d3=(pt.Position-myPos).Magnitude
                        local score=d2+d3*0.05
                        if score<bs then best,bs=pt,score end
                    end
                end
            end
        end
    end
    return best
end
RS.RenderStepped:Connect(function()
    if not S.aimbot then return end
    if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local t=getAimTarget()
    if not t then return end
    local targetPos=t.Position
    if S.aimPredict then
        local hrp=t.Name=="HumanoidRootPart" and t or (t.Parent and t.Parent:FindFirstChild("HumanoidRootPart"))
        if hrp and hrp.AssemblyLinearVelocity then
            local v=hrp.AssemblyLinearVelocity
            local d=(hrp.Position-Cam.CFrame.Position).Magnitude
            targetPos=targetPos+v*(d/1000)
        end
    end
    local dist=(targetPos-Cam.CFrame.Position).Magnitude
    local sf=dist<50 and 1 or math.clamp(S.aimSmooth,0.05,1)
    Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position,targetPos),sf)
end)

