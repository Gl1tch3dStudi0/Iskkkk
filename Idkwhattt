    Lighting.Ambient=Color3.fromRGB(70,70,70)
    Lighting.OutdoorAmbient=Color3.fromRGB(128,128,128)
    Lighting.Brightness=1
    Lighting.ClockTime=14
    Lighting.FogColor=Color3.fromRGB(128,128,128)
    Lighting.FogEnd=1e5
    Lighting.FogStart=0
    Lighting.GlobalShadows=true
    notif("GS","sky reset")
end})
ST:CreateSection("Sky Utilities")
ST:CreateSlider({Name="Brightness",Range={0,10},Increment=0.1,Suffix="",CurrentValue=1,Flag="sky_bright",Callback=function(v) Lighting.Brightness=v end})
ST:CreateSlider({Name="Clock Time",Range={0,24},Increment=0.1,Suffix="h",CurrentValue=14,Flag="sky_time",Callback=function(v) Lighting.ClockTime=v end})
ST:CreateSlider({Name="Fog End",Range={0,5000},Increment=50,Suffix="",CurrentValue=1e5,Flag="sky_fogend",Callback=function(v) Lighting.FogEnd=v end})
ST:CreateSlider({Name="Star Count",Range={0,10000},Increment=100,Suffix="",CurrentValue=3000,Flag="sky_stars",Callback=function(v)
    if currentSky then currentSky.StarCount=v end
end})

TT:CreateSection("Teleport to Player")
local function pNames()
    local n={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then table.insert(n,p.Name) end
    end
    return n
end
local pd=TT:CreateDropdown({Name="Target Player",Options=pNames(),CurrentOption={},Flag="tp_target",Callback=function(o) tpTarget=o[1] end})
TT:CreateButton({Name="Refresh Player List",Callback=function()
    pcall(function() pd:Refresh(pNames()) end)
end})
TT:CreateButton({Name="TP Above Target",Callback=function()
    if not tpTarget then return end
    local t=Players:FindFirstChild(tpTarget)
    local hrp=getHRP()
    local th=t and t.Character and t.Character:FindFirstChild("HumanoidRootPart")
    if hrp and th then hrp.CFrame=th.CFrame*CFrame.new(0,3,0) end
end})
TT:CreateSection("Cross-Place")
TT:CreateInput({Name="PlaceId",PlaceholderText="placeId",RemoveTextAfterFocusLost=false,Flag="tp_place",Callback=function(txt) _G.kPlace=txt end})
TT:CreateButton({Name="Join Place",Callback=function()
    local p=tonumber(_G.kPlace)
    if not p then notif("GS","invalid placeId") return end
    TS:Teleport(p,LP)
end})

XT:CreateSection("Anti-AFK")
XT:CreateToggle({Name="Anti-AFK",CurrentValue=false,Flag="antiafk",Callback=function(v)
    S.antiAfk=v
    if v and not _G.kAFKBound then
        _G.kAFKBound=true
        LP.Idled:Connect(function()
            if not S.antiAfk then return end
            VU:CaptureController()
            VU:ClickButton2(Vector2.new())
        end)
    end
end})
XT:CreateSection("Server")
XT:CreateButton({Name="Rejoin",Callback=function() TS:Teleport(game.PlaceId,LP) end})
XT:CreateButton({Name="Server Hop",Callback=function()
    local ok,res=pcall(function()
        return HS:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
    end)
    if ok and res and res.data then
        for _,srv in ipairs(res.data) do
            if srv.playing<srv.maxPlayers and srv.id~=game.JobId then
                TS:TeleportToPlaceInstance(game.PlaceId,srv.id,LP)
                return
            end
        end
    end
end})
XT:CreateSection("Client")
XT:CreateButton({Name="Copy Join Script",Callback=function()
    local s='game:GetService("TeleportService"):TeleportToPlaceInstance('..game.PlaceId..',"'..game.JobId..'",game.Players.LocalPlayer)'
    pcall(function() setclipboard(s) end)
    notif("GS","join script copied")
end})

